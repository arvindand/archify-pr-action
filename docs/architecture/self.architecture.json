  "boundaries": [
    {
      "kind": "region",
      "label": "GitHub Actions runner",
      "wraps": [
        "runner",
        "compare",
        "archify-cli",
        "artifacts",
        "comment",
        "receipt"
      ]
    }
  ],
  "connections": [
    {
      "id": "trigger",
      "from": "pr-event",
      "to": "runner",
      "label": "triggers",
      "variant": "emphasis"
    },
    {
      "id": "invoke-compare",
      "from": "runner",
      "to": "compare",
      "label": "BASE_SHA + inputs",
      "labelDy": -24
    },
    {
      "id": "cli-calls",
      "from": "compare",
      "to": "archify-cli",
      "label": "validate / compare",
      "labelDy": -24
    },
    {
      "id": "write-artifacts",
      "from": "compare",
      "to": "artifacts",
      "label": "delta HTML"
    },
    {
      "id": "results-handoff",
      "from": "compare",
      "to": "comment",
      "label": "results.json",
      "labelDy": 24
    },
    {
      "id": "upsert",
      "from": "comment",
      "to": "github-api",
      "label": "sticky comment",
      "variant": "security"
    },
    {
      "id": "vendor-fetch",
      "from": "runner",
      "to": "vendor-cache",
      "label": "downloads"
    },
    {
      "id": "emit-receipt",
      "from": "archify-cli",
      "to": "receipt",
      "label": "emits"
    }
  ]
}
